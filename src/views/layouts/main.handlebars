  <!-- Footer Bắt Buộc Theo Đề Thi -->
  <footer class="app-footer">
    <div class="footer-primary-text">
      Họ tên: {{appMetadata.studentName}} | MSSV: {{appMetadata.studentId}} | Mức VAT áp dụng: {{appMetadata.vatRate}}%
