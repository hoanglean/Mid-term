# ==============================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO ỨNG DỤNG QUẢN LÝ SÁCH CLOUD
# Sinh viên: Hoàng Lê An | MSSV: 23IT003 | Database: DB_23IT003
# ==============================================================

# Cổng khởi chạy ứng dụng
PORT=3000

# Khóa bí mật cho Session Express
SESSION_SECRET=hoang_le_an_23it003_secure_cloud_session_key

# 1. KẾT NỐI ĐỌC (Mongoose Read Connection)
# Tài khoản phân quyền: read_23it003 (Chỉ cấp quyền readAnyDatabase hoặc read trên DB_23IT003)
MONGO_URI_READ=mongodb+srv://read_23it003:<PASSWORD>@<CLUSTER_ADDRESS>/DB_23IT003?retryWrites=true&w=majority

# 2. KẾT NỐI GHI (Mongoose Write Connection + Lưu Session Stateless)
# Tài khoản phân quyền: write_23it003 (Cấp quyền readWrite trên DB_23IT003)
MONGO_URI_WRITE=mongodb+srv://write_23it003:<PASSWORD>@<CLUSTER_ADDRESS>/DB_23IT003?retryWrites=true&w=majority

# 3. THÔNG SỐ CÁ NHÂN HÓA DỰ ÁN
STUDENT_NAME=Hoàng Lê An
STUDENT_ID=23IT003
BOOK_PREFIX=003
VAT_RATE=7
